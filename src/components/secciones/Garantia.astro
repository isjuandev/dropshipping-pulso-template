---
/**
 * Garantía: sello circular + qué cubre.
 */
import Icono from '../ui/Icono.astro';
import type { Producto } from '../../lib/tipos';

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
---

<section id="garantia" class="bg-blanco py-14 md:py-20">
  <div class="contenedor">
    <div class="tarjeta grid items-center gap-6 p-5 md:grid-cols-[auto_1fr] md:gap-8 md:p-7">
      <div class="sello mx-auto size-32 shrink-0 rotate-[-6deg] md:size-36">
        <span class="flex flex-col items-center gap-0.5 px-3 text-center">
          <span class="tabular font-titular text-4xl leading-none md:text-5xl">
            {producto.garantia.dias}
          </span>
          <span class="font-titular text-[11px] uppercase leading-tight tracking-wide md:text-xs">
            días de garantía
          </span>
        </span>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="text-2xl md:text-3xl">{producto.garantia.titulo}</h2>
        <p class="max-w-[58ch] text-[15px] text-tinta/80 md:text-base">{producto.garantia.texto}</p>

        <ul class="mt-1 grid gap-1.5 sm:grid-cols-2">
          {
            producto.garantia.cubre.map((item) => (
              <li class="flex items-start gap-2 text-[15px] leading-snug">
                <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-exito">
                  <Icono name="check" size={13} strokeWidth={4} class="text-tinta" />
                </span>
                <span class="text-tinta/80">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
