---
/**
 * Problema y solución: 3 dolores + la tarjeta de solución con el producto.
 */
import { Picture } from 'astro:assets';
import Icono from '../ui/Icono.astro';
import type { Producto } from '../../lib/tipos';

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const imagenPrincipal = producto.imagenes[0];
---

<section id="problema" class="bg-blanco py-14 md:py-20">
  <div class="contenedor">
    <h2 class="max-w-[16ch] md:max-w-none">¿Cansado de esto?</h2>

    <ul class="mt-6 grid gap-4 md:grid-cols-3 md:gap-5">
      {
        producto.dolores.map((dolor) => (
          <li class="tarjeta-humo flex flex-col gap-2 p-5">
            <span class="grid size-10 place-items-center rounded-[10px] border-2 border-tinta bg-blanco text-oferta">
              <Icono name="alerta" size={20} />
            </span>
            <h3 class="text-lg">{dolor.titulo}</h3>
            <p class="text-[15px] text-tinta/75">{dolor.texto}</p>
          </li>
        ))
      }
    </ul>

    <!-- Solución -->
    <div class="tarjeta mt-6 grid items-center gap-5 bg-electrico p-5 md:mt-8 md:grid-cols-[1fr_1fr] md:p-7">
      <div class="flex flex-col gap-3">
        <span class="insignia w-fit bg-tinta text-blanco">La solución</span>
        <h3 class="text-2xl md:text-3xl">
          {producto.nombre}: tu licuadora de bolsillo
        </h3>
        <p class="max-w-[46ch] text-[15px] text-tinta/80 md:text-base">
          {producto.descripcion}
        </p>
        <ul class="flex flex-col gap-1.5">
          {
            producto.beneficios.slice(0, 3).map((beneficio) => (
              <li class="flex items-start gap-2 text-[15px] leading-snug">
                <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-exito">
                  <Icono name="check" size={13} strokeWidth={4} class="text-tinta" />
                </span>
                <span>
                  <strong class="font-semibold">{beneficio.titulo}.</strong>{' '}
                  <span class="text-tinta/75">{beneficio.texto}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="overflow-hidden rounded-brutal border-2 border-tinta bg-blanco">
        {
          imagenPrincipal && (
            <Picture
              src={imagenPrincipal}
              formats={['avif', 'webp']}
                  fallbackFormat="webp"
              widths={[400, 640]}
              sizes="(max-width: 768px) 92vw, 520px"
              alt={`${producto.nombre}, licuadora portátil recargable USB-C`}
              loading="lazy"
              decoding="async"
              class="block h-full w-full object-cover"
            />
          )
        }
      </div>
    </div>
  </div>
</section>
