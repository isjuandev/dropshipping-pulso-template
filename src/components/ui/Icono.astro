---
/**
 * Iconos inline (Lucide, trazo 2 px) + glifos de marca.
 * En .astro siempre SVG inline: cero JS extra.
 */
export type NombreIcono =
  | 'check'
  | 'x'
  | 'zap'
  | 'timer'
  | 'bag'
  | 'sparkles'
  | 'battery'
  | 'volume'
  | 'truck'
  | 'shield'
  | 'users'
  | 'wallet'
  | 'package'
  | 'clock'
  | 'map-pin'
  | 'alerta'
  | 'chevron'
  | 'arrow-right'
  | 'star'
  | 'refresh'
  | 'check-circle'
  | 'message'
  | 'like'
  | 'minus'
  | 'phone'
  | 'mail'
  | 'whatsapp'
  | 'instagram'
  | 'facebook'
  | 'tiktok';

interface Props {
  name: NombreIcono;
  size?: number;
  class?: string;
  /** Trazo en px. 2 por defecto (Lucide). */
  strokeWidth?: number;
  /** Rellena el icono con el color actual (estrellas, marcas). */
  relleno?: boolean;
}

const { name, size = 24, class: className = '', strokeWidth = 2, relleno = false } = Astro.props;

const trazos: Record<NombreIcono, string> = {
