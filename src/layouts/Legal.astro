---
/**
 * Layout de páginas legales: misma cabecera y pie que la landing.
 * El texto es 100 % editable dentro de cada página.
 */
import Base from './Base.astro';
import Header from '../components/secciones/Header.astro';
import Footer from '../components/secciones/Footer.astro';
import { tienda } from '../config/tienda';

interface Props {
  titulo: string;
  descripcion: string;
  ruta: string;
  actualizado: string;
}

const { titulo, descripcion, ruta, actualizado } = Astro.props;
---

<Base titulo={titulo} descripcion={descripcion} ruta={ruta}>
  <Header />

  <main class="bg-blanco py-10 md:py-14">
    <div class="contenedor">
      <nav aria-label="Migas de pan: volver a la tienda" class="mb-4">
        <a href="/" class="text-sm text-gris enlace-fuerte hover:text-oferta-oscuro">
          <span aria-hidden="true">←</span> Volver a la tienda
        </a>
      </nav>

      <header class="mb-8 max-w-3xl">
        <h1 class="text-3xl md:text-4xl">{titulo}</h1>
        <p class="mt-2 text-sm text-gris">Última actualización: {actualizado}</p>
      </header>

      <div class="prose-legal max-w-3xl">
        <slot />
      </div>

      <aside class="mt-10 max-w-3xl rounded-brutal border-2 border-tinta bg-electrico p-5">
        <h2 class="text-xl">¿Te quedó alguna duda?</h2>
        <p class="mt-1 text-[15px] text-tinta/80">
          Escríbenos por WhatsApp al {tienda.whatsappDisplay} y te respondemos en menos de 5
          minutos, de {tienda.horarioAtencion}.
        </p>
        <a
          href={`https://wa.me/${tienda.codigoPais}${tienda.whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          class="boton boton-primario mt-4 min-h-12 px-5 py-2.5 text-sm"
        >
          Escribir por WhatsApp
        </a>
      </aside>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .prose-legal :global(h2) {
    font-size: 1.375rem;
    line-height: 1.75rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .prose-legal :global(p) {
    margin-bottom: 0.75rem;
    color: var(--color-tinta);
    opacity: 0.85;
  }

  .prose-legal :global(ul) {
    margin: 0 0 1rem 0;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .prose-legal :global(li) {
    margin-bottom: 0.375rem;
    color: var(--color-tinta);
    opacity: 0.85;
  }

  .prose-legal :global(strong) {
    font-weight: 600;
  }
</style>
