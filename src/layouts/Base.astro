---
/**
 * Layout base: head con SEO/Open Graph/JSON-LD, fuentes y analítica.
 * Los scripts de analítica solo se cargan si hay ID en variables de entorno.
 */
import { tienda } from '../config/tienda';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta canónica con slash final. */
  ruta: string;
  /** Imagen Open Graph (URL absoluta). */
  imagen?: string;
  /** Tipo de contenido Open Graph. */
  tipoOg?: 'website' | 'product';
  /** Datos extra de JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noIndex?: boolean;
}

const {
  titulo,
  descripcion,
  ruta,
  imagen,
  tipoOg = 'website',
  jsonLd,
  noIndex = false,
} = Astro.props;

const sitio = tienda.sitio;
const canonico = new URL(ruta.endsWith('/') ? ruta : `${ruta}/`, sitio).toString();
const imagenOg = imagen ?? `${sitio}/og/og-blendgo.png`;

const organizacion = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tienda.nombreTienda,
  legalName: tienda.legal.razonSocial,
  url: sitio,
  logo: `${sitio}/logo.svg`,
  telephone: tienda.legal.telefono,
  email: tienda.legal.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: tienda.legal.direccion,
    addressCountry: 'CO',
  },
  sameAs: [tienda.redes.instagram.url, tienda.redes.facebook.url, tienda.redes.tiktok.url],
};

const datosLd = jsonLd
  ? [organizacion, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
  : [organizacion];

const gtmActivo = Boolean(tienda.gtmId);
const pixelActivo = Boolean(tienda.pixelId);
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFD60A" />

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonico} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={tipoOg} />
    <meta property="og:site_name" content={tienda.nombreTienda} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonico} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenOg} />

    <!-- Fuentes self-hosted: solo el titular se precarga -->
    <link
      rel="preload"
      href="/fonts/archivo-black-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- JSON-LD -->
    {
      datosLd.map((dato) => (
        <script type="application/ld+json" set:html={JSON.stringify(dato)} is:inline />
      ))
    }

    <!-- Analítica: solo si hay ID configurado -->
    {
      gtmActivo && (
        <>
          <script define:vars={{ gtmId: tienda.gtmId }}>
            (function (w, d, s, l, i) {
              w[l] = w[l] || [];
              w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
              var f = d.getElementsByTagName(s)[0];
              var j = d.createElement(s);
              var dl = l != 'dataLayer' ? '&l=' + l : '';
              j.async = true;
              j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
              f.parentNode.insertBefore(j, f);
            })(window, document, 'script', 'dataLayer', gtmId);
          </script>
          <noscript
            ><iframe
              src={`https://www.googletagmanager.com/ns.html?id=${tienda.gtmId}`}
              height="0"
              width="0"
              style="display:none;visibility:hidden"
              title="Google Tag Manager"></iframe></noscript
          >
        </>
      )
    }

    {
      pixelActivo && (
        <script define:vars={{ pixelId: tienda.pixelId }}>
          !(function (f, b, e, v, n, t, s) {
            if (f.fbq) return;
            n = f.fbq = function () {
              n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
            };
            if (!f._fbq) f._fbq = n;
            n.push = n;
            n.loaded = !0;
            n.version = '2.0';
            n.queue = [];
            t = b.createElement(e);
            t.async = !0;
            t.src = v;
            s = b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t, s);
          })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', pixelId);
          fbq('track', 'PageView');
        </script>
      )
    }
  </head>

  <body>
    <slot />
  </body>
</html>
